// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
  
}

model User {
  id                     String           @id @default(uuid())
  name                   String
  username               String           @unique
  email                  String           @unique
  password               String?
  affiliation            String?
  profileImage           String?
  resetToken             String?          @unique
  resetTokenExpiry       DateTime?
  isVerified             Boolean          @default(false)
  userType               UserType         @default(USER)
  verificationCode       String?
  verificationCodeExpiry DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  authoredPapers         ResearchPaper[]  @relation("PaperAuthor")
  reviews                PaperReview[]    @relation("ReviewerToReview")
}

model ResearchPaper {
  id              String         @id @default(uuid())
  title           String
  abstract        String
  filePath        String
  keywords        String[]
  rating          Int?
  coverLetterPath String?
  submissionDate  DateTime       @default(now())
  lastUpdated     DateTime       @updatedAt
  acceptedDate    DateTime?
  status          PaperStatus    @default(UPLOAD)

  authorId        String?
  author          User?          @relation("PaperAuthor", fields: [authorId], references: [id])

  contributors    Json
  pointOfContact  Json

  reviewerStatus  ReviewerStatus @default(PENDING)
  reviews         PaperReview[]  @relation("PaperToReviews")
}

model PaperReview {
  id                String         @id @default(uuid())
  paperId           String
  reviewerId        String

  paper             ResearchPaper  @relation("PaperToReviews", fields: [paperId], references: [id])
  reviewer          User           @relation("ReviewerToReview", fields: [reviewerId], references: [id])

  reviewText        String
  correspondingFile String?
  rating            Int?
  reviewerStatus    ReviewerStatus @default(PENDING)
  revisionType      RevisionType   @default(NONE) // NEW ENUM for major/minor/none

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([paperId, reviewerId]) // Ensures one review per reviewer per paper
}

enum PaperStatus {
  UPLOAD
  REVIEWER_ALLOCATION
  ON_REVIEW
  ON_EDIT
  PUBLISH
  ACCEPTED
  REJECTED
}

enum ReviewerStatus {
  ACCEPTED_FOR_PUBLICATION
  REJECTED_FOR_PUBLICATION
  ACCEPTED_FOR_REVIEW
  REJECTED_FOR_REVIEW
  PENDING
}


enum RevisionType {
  NONE
  MINOR
  MAJOR
}

enum UserType {
  USER
  REVIEWER
  EDITOR
  ADMIN
}

model UserDetails {
  id       String   @id @default(uuid())
  email    String   @unique
  userType UserType
}
