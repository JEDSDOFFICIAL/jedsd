generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model User {
  id                     String          @id @default(uuid())
  name                   String
  email                  String          @unique
  password               String?
  affiliation            String?
  profileImage           String?
  resetToken             String?         @unique
  resetTokenExpiry       DateTime?
  isVerified             Boolean         @default(false)
  userType               UserType        @default(USER)
  verificationCode       String?
  verificationCodeExpiry DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  reviews                PaperReview[]   @relation("UserToReviews")
  authoredPapers         ResearchPaper[] @relation("PaperAuthor")

  @@index([email])
  @@index([resetToken])
  @@index([verificationCode])
}

model PaperReview {
  id                String          @id @default(uuid())
  paperId           String
  reviewerId        String
  reviewText        String
  correspondingFile String?
  rating            Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  reviewerStatus    ReviewerStatus?
  paper             ResearchPaper   @relation("PaperToReviews", fields: [paperId], references: [id])
  reviewer          User            @relation("UserToReviews", fields: [reviewerId], references: [id])
}

model ResearchPaper {
  id              String        @id @default(uuid())
  title           String
  abstract        String
  filePath        String
  keywords        String[]
  rating          Int?
  coverLetterPath String?
  submissionDate  DateTime      @default(now())
  lastUpdated     DateTime      @updatedAt
  acceptedDate    DateTime?
  status          PaperStatus   @default(UPLOAD)
  authorId        String?
  contributors    Json
  pointOfContact  Json
  reviews         PaperReview[] @relation("PaperToReviews")
  author          User?         @relation("PaperAuthor", fields: [authorId], references: [id])
}

model UserDetails {
  id       String   @id @default(uuid())
  email    String   @unique
  userType UserType
}

enum PaperStatus {
  UPLOAD
  REVIEWER_ALLOCATION
  ON_REVIEW
  ON_EDIT
  PUBLISH
  ACCEPTED
  REJECTED
}

enum ReviewerStatus {
  ACCEPTED_FOR_PUBLICATION
  REJECTED_FOR_PUBLICATION
  ACCEPTED_FOR_REVIEW
  REJECTED_FOR_REVIEW
  PENDING
  MINOR_REVISION
  MAJOR_REVISION
}

enum UserType {
  USER
  REVIEWER
  EDITOR
  ADMIN
}
