// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
  
}



model User {
  id                     String          @id @default(uuid())
  name                   String
  username               String          @unique
  email                  String          @unique
  password               String?
  affiliation            String?
  profileImage           String?
  resetToken             String?         @unique
  resetTokenExpiry       DateTime?
  isVerified             Boolean         @default(false)
  userType               UserType        @default(USER)
  verificationCode       String?
  verificationCodeExpiry DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  reviewedPapers         ResearchPaper[] @relation("PaperReviewer")
  authoredPapers         ResearchPaper[] @relation("PaperAuthor")
  editoredPapers         ResearchPaper[] @relation("PaperEditor")
}

model PaperReview {
  id                String       @id @default(uuid())
  paperId           String
  paper             ResearchPaper @relation("PaperToReviews",fields: [paperId], references: [id])

  reviewerId        String?

  editorId          String?


  reviewText        String
  correspondingFile String?
  rating            Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  reviewerStatus    ReviewerStatus?
  editorStatus      EditorStatus?
}


model ResearchPaper {
  id              String   @id @default(uuid())
  title           String
  abstract        String
  filePath        String
  keywords        String[]
  rating          Int?
  coverLetterPath String?
  submissionDate  DateTime    @default(now())
  lastUpdated     DateTime    @updatedAt
  acceptedDate    DateTime?
  status          PaperStatus @default(UPLOAD)

  reviewerId String?
  reviewer   User?   @relation("PaperReviewer", fields: [reviewerId], references: [id])

  authorId String?
  author   User?   @relation("PaperAuthor", fields: [authorId], references: [id])
  editorId String?
  editor   User?   @relation("PaperEditor",fields: [editorId], references: [id])

  contributors   Json 
  pointOfContact Json 

  reviewerStatus ReviewerStatus @default(PENDING)
  editorStatus   EditorStatus   @default(PENDING)
  reviews        PaperReview[]  @relation("PaperToReviews")
}


enum PaperStatus {
  UPLOAD
  REVIEWER_ALLOCATION
  ON_REVIEW
  EDITOR_ALLOCATION
  ON_EDIT
  PUBLISH
  ACCEPTED
  REJECTED
}
enum ReviewerStatus {
  ACCEPTED_FOR_PUBLICATION
  REJECTED_FOR_PUBLICATION
  ACCEPTED_FOR_REVIEW
  REJECTED_FOR_REVIEW
  PENDING
}
enum EditorStatus {
  ACCEPTED_FOR_PUBLICATION
  REJECTED_FOR_PUBLICATION
  ACCEPTED_FOR_EDIT
  REJECTED_FOR_EDIT
  PENDING
}

enum UserType {
  USER
  REVIEWER
  EDITOR
  ADMIN
}


model UserDetails {
  id       String   @id @default(uuid())
  email    String   @unique
  userType UserType
}
